{
  "name": "@contextrocket/site-publisher",
  "version": "0.1.0",
  "description": "Publish static ContextRocket sites from Node.js and TypeScript",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ContextRocket/cr-sdk.git",
    "directory": "packages/site-publisher"
  },
  "homepage": "https://github.com/ContextRocket/cr-sdk/tree/main/packages/site-publisher#readme",
  "bugs": {
    "url": "https://github.com/ContextRocket/cr-sdk/issues"
  },
  "keywords": ["contextrocket", "static-site", "cdn", "publisher", "cli"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "contextrocket-site-publish": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "minimatch": "^10.0.3",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/tar-stream": "^3.1.4",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
