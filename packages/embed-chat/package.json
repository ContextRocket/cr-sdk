{
  "name": "@contextrocket/embed-chat",
  "version": "0.1.2",
  "description": "ContextRocket embeddable chat widget (standalone IIFE)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ContextRocket/cr-sdk.git",
    "directory": "packages/embed-chat"
  },
  "homepage": "https://github.com/ContextRocket/cr-sdk/tree/main/packages/embed-chat#readme",
  "bugs": {
    "url": "https://github.com/ContextRocket/cr-sdk/issues"
  },
  "keywords": [
    "contextrocket",
    "chat-widget",
    "a2a",
    "agent",
    "embed"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @contextrocket/sdk build",
    "build": "node build.mjs",
    "pretypecheck": "pnpm --filter @contextrocket/sdk build",
    "prepack": "pnpm run build",
    "pretest": "pnpm --filter @contextrocket/sdk build",
    "typecheck": "tsc --noEmit",
    "test": "playwright install --only-shell chromium && vitest run",
    "verify": "pnpm run typecheck && node build.mjs && node -e \"const{statSync}=require('node:fs');const p='dist/widget.js';const s=statSync(p);if(s.size<1000){console.error('widget.js too small: '+s.size+' bytes');process.exit(1)}console.log('OK '+p+' ('+s.size+' bytes)')\""
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "playwright": "1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@contextrocket/sdk": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
