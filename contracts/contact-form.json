{
  "version": 2,
  "boundary": "organization contact form",
  "request": {
    "method": "POST",
    "path": "/api/orgs/{org_handle}/contacts",
    "headers": ["content-type: application/json", "idempotency-key (optional)"],
    "fields": ["app_id", "name", "company", "email", "phone", "message", "intent", "source_channel", "consent", "custom_answers", "campaign_ref", "landing_page_ref", "site_release_ref", "variant_ref", "source_url", "referrer_origin", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "consent_policy_version", "consent_copy_version", "controller_mode"]
  },
  "response": {
    "status": 201,
    "fields": ["contact_id", "status", "delivery_state", "follow_up_state"],
    "delivery_states": ["accepted", "queued", "sent", "unavailable", "duplicate", "error"]
  }
}
